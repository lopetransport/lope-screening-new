# Server-only Vercel environment variable. Never prefix this with VITE_.
HUBSPOT_ACCESS_TOKEN=
# Connect a Public Vercel Blob store to populate this server-only token.
BLOB_READ_WRITE_TOKEN=
# Optional. If missing, full submissions remain saved as HubSpot notes.
RESEND_API_KEY=
# Must be a sender from a verified Resend domain when email is enabled.
APPLICATION_FROM_EMAIL=Lope Transport Services <ops@lopetransport.co.za>
# Optional independent random signing secret; otherwise the HubSpot token signs upload sessions.
APPLICATION_SIGNING_SECRET=
# Replace these with approved company policy text before accepting real applications.
VITE_TERMS_TEXT=
VITE_PRIVACY_TEXT=
